generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  CREATED
  PENDING
  SUCCESS
  CLOSED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum IntegrationProtocol {
  NATIVE_V1
  EPAY_V1
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCESS
  FAILED
  UNKNOWN
  CLOSED
}

enum PaymentChannelCode {
  ALIPAY
  ALIPAY_BILL
  MOCK
}

enum RefundStatus {
  CREATED
  PROCESSING
  SUCCESS
  FAILED
  UNKNOWN
}

enum WebhookStatus {
  PENDING
  PROCESSING
  SUCCESS
  DEAD
}

enum ReceiptDirection {
  INCOME
  REFUND
}

enum ReceiptMatchStatus {
  UNMATCHED
  PROCESSING
  MATCHED
  MISMATCH
  IGNORED
}

enum ReceiptMatchMode {
  DIRECT
  REMARK
  AMOUNT
}

enum PaymentExceptionType {
  LATE_DUPLICATE
  RECEIPT_AMBIGUOUS
  PAYMENT_STATE_CONFLICT
}

enum PaymentExceptionStatus {
  OPEN
  PROCESSING
  RESOLVED
  IGNORED
}

enum PaymentExceptionSeverity {
  MEDIUM
  HIGH
  CRITICAL
}

enum ReconciliationRunStatus {
  PROCESSING
  SUCCESS
  FAILED
}

model Application {
  id                     String             @id @default(cuid())
  appId                  String             @unique @db.VarChar(40)
  name                   String             @db.VarChar(120)
  status                 ApplicationStatus  @default(ACTIVE)
  apiKeyHash             String             @db.Char(64)
  webhookUrl             String?            @db.VarChar(500)
  webhookSecretEncrypted String             @db.Text
  epayPid                String             @unique @db.VarChar(32)
  epayKeyEncrypted       String             @db.Text
  defaultChannel         PaymentChannelCode @default(MOCK)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  orders                 Order[]
  refunds                Refund[]
  webhookDeliveries      WebhookDelivery[]

  @@index([status, createdAt])
  @@map("applications")
}

model Order {
  id                String              @id @default(cuid())
  orderNo           String              @unique @db.VarChar(40)
  externalOrderNo   String              @db.VarChar(80)
  applicationId     String
  amount            Int                 @db.UnsignedInt
  currency          String              @default("CNY") @db.Char(3)
  subject           String              @db.VarChar(160)
  description       String?             @db.VarChar(500)
  metadata          Json?
  protocol          IntegrationProtocol @default(NATIVE_V1)
  notifyUrl         String?             @db.VarChar(500)
  returnUrl         String?             @db.VarChar(500)
  status            OrderStatus         @default(CREATED)
  idempotencyKey    String?             @db.VarChar(120)
  requestHash       String              @db.Char(64)
  winningPaymentId  String?             @db.VarChar(32)
  expiresAt         DateTime?
  expirationAttempts Int                @default(0) @db.UnsignedSmallInt
  expirationNextAttemptAt DateTime?
  expirationLockedUntil DateTime?
  expirationError   String?             @db.VarChar(500)
  paidAt            DateTime?
  closedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  application       Application         @relation(fields: [applicationId], references: [id])
  payments          Payment[]
  events            PaymentEvent[]
  webhookDeliveries WebhookDelivery[]
  paymentExceptions PaymentException[]

  @@unique([applicationId, externalOrderNo])
  @@unique([applicationId, idempotencyKey])
  @@index([applicationId, status, createdAt])
  @@index([createdAt, id])
  @@index([status, expirationNextAttemptAt, id])
  @@map("orders")
}

model Payment {
  id             String             @id @default(cuid())
  paymentNo      String             @unique @db.VarChar(40)
  orderId        String
  attemptNo      Int                @db.UnsignedSmallInt
  idempotencyKey String?            @db.VarChar(120)
  channel        PaymentChannelCode
  method         String             @db.VarChar(32)
  status         PaymentStatus      @default(CREATED)
  amount         Int                @db.UnsignedInt
  channelAmount  Int                @db.UnsignedInt
  receivedAmount Int?               @db.UnsignedInt
  channelTradeNo String?            @unique @db.VarChar(100)
  channelOrderNo String?            @db.VarChar(100)
  receiptMatchMode ReceiptMatchMode?
  receiptMatchReference String?     @db.VarChar(64)
  receiptValidFrom DateTime?
  receiptValidUntil DateTime?
  clientPayload  Json?
  rawResponse    Json?
  errorCode      String?            @db.VarChar(80)
  errorMessage   String?            @db.VarChar(500)
  queryAttempts  Int                @default(0) @db.UnsignedSmallInt
  nextQueryAt    DateTime?
  lastQueriedAt  DateTime?
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  order          Order              @relation(fields: [orderId], references: [id])
  refunds        Refund[]
  events         PaymentEvent[]
  receipts       Receipt[]
  paymentExceptions PaymentException[]
  receiptReservation ReceiptMatchReservation?

  @@unique([orderId, attemptNo])
  @@unique([orderId, idempotencyKey])
  @@index([orderId, status, createdAt])
  @@index([status, updatedAt])
  @@index([status, nextQueryAt, id])
  @@index([channel, receiptMatchReference])
  @@index([channel, channelAmount, receiptValidUntil])
  @@map("payments")
}

model Refund {
  id               String       @id @default(cuid())
  refundNo         String       @unique @db.VarChar(40)
  externalRefundNo String       @db.VarChar(80)
  applicationId    String
  paymentId        String
  amount           Int          @db.UnsignedInt
  reason           String?      @db.VarChar(300)
  status           RefundStatus @default(CREATED)
  channelRefundNo  String?      @db.VarChar(100)
  rawResponse      Json?
  errorCode        String?      @db.VarChar(80)
  errorMessage     String?      @db.VarChar(500)
  queryAttempts    Int          @default(0) @db.UnsignedSmallInt
  nextQueryAt      DateTime?
  lastQueriedAt    DateTime?
  succeededAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  application      Application  @relation(fields: [applicationId], references: [id])
  payment          Payment      @relation(fields: [paymentId], references: [id])
  receipts         Receipt[]

  @@unique([applicationId, externalRefundNo])
  @@index([paymentId, status, createdAt])
  @@index([applicationId, createdAt])
  @@index([status, nextQueryAt, id])
  @@map("refunds")
}

model PaymentEvent {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  aggregateType String   @db.VarChar(24)
  aggregateId   String   @db.VarChar(40)
  orderId       String?
  paymentId     String?
  type          String   @db.VarChar(64)
  source        String   @db.VarChar(32)
  requestId     String?  @db.VarChar(64)
  payload       Json?
  createdAt     DateTime @default(now())
  order         Order?   @relation(fields: [orderId], references: [id])
  payment       Payment? @relation(fields: [paymentId], references: [id])
  ownerSeen     OwnerNotificationSeen?

  @@index([aggregateType, aggregateId, id])
  @@index([orderId, id])
  @@index([paymentId, id])
  @@index([createdAt, id])
  @@map("payment_events")
}

model ChannelCallback {
  id           BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  channel      PaymentChannelCode
  eventKey     String             @db.VarChar(160)
  paymentNo    String?            @db.VarChar(40)
  verified     Boolean            @default(false)
  processed    Boolean            @default(false)
  rawPayload   Json
  errorMessage String?            @db.VarChar(500)
  createdAt    DateTime           @default(now())
  processedAt  DateTime?

  @@unique([channel, eventKey])
  @@index([paymentNo, createdAt])
  @@map("channel_callbacks")
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  applicationId  String
  orderId        String
  eventType      String              @db.VarChar(80)
  protocol       IntegrationProtocol
  url            String              @db.VarChar(500)
  payload        Json
  status         WebhookStatus       @default(PENDING)
  attempts       Int                 @default(0) @db.UnsignedSmallInt
  maxAttempts    Int                 @default(8) @db.UnsignedSmallInt
  nextAttemptAt  DateTime            @default(now())
  lockedUntil    DateTime?
  lastError      String?             @db.VarChar(500)
  responseStatus Int?
  responseBody   String?             @db.Text
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  application    Application         @relation(fields: [applicationId], references: [id])
  order          Order               @relation(fields: [orderId], references: [id])

  @@unique([orderId, eventType, url])
  @@index([status, nextAttemptAt, id])
  @@index([lockedUntil, status])
  @@index([applicationId, createdAt])
  @@map("webhook_deliveries")
}

model Receipt {
  id                String             @id @default(cuid())
  provider          PaymentChannelCode
  statementDate     DateTime           @db.Date
  direction         ReceiptDirection
  providerTradeNo   String?            @db.VarChar(100)
  merchantOrderNo   String?            @db.VarChar(80)
  providerRefundNo  String?            @db.VarChar(100)
  merchantRefundNo  String?            @db.VarChar(80)
  amount            Int                @db.UnsignedInt
  currency          String             @default("CNY") @db.Char(3)
  occurredAt        DateTime
  fingerprint       String             @unique @db.Char(64)
  matchStatus       ReceiptMatchStatus @default(UNMATCHED)
  mismatchReason    String?            @db.VarChar(500)
  accountKey        String?            @db.VarChar(80)
  remark            String?            @db.VarChar(300)
  matchMode         ReceiptMatchMode?
  lockedUntil       DateTime?
  rawPayload        Json
  paymentId         String?
  refundId          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payment           Payment?           @relation(fields: [paymentId], references: [id])
  refund            Refund?            @relation(fields: [refundId], references: [id])

  @@index([provider, statementDate, id])
  @@index([matchStatus, occurredAt, id])
  @@index([provider, matchStatus, lockedUntil])
  @@index([paymentId, id])
  @@index([refundId, id])
  @@map("receipts")
}

model ReconciliationRun {
  id              String                  @id @default(cuid())
  provider        PaymentChannelCode
  statementDate   DateTime                @db.Date
  status          ReconciliationRunStatus @default(PROCESSING)
  fileName        String?                 @db.VarChar(255)
  importedCount   Int                     @default(0) @db.UnsignedInt
  duplicateCount  Int                     @default(0) @db.UnsignedInt
  matchedCount    Int                     @default(0) @db.UnsignedInt
  mismatchedCount Int                     @default(0) @db.UnsignedInt
  unmatchedCount  Int                     @default(0) @db.UnsignedInt
  skippedCount    Int                     @default(0) @db.UnsignedInt
  errorMessage    String?                 @db.VarChar(500)
  startedAt       DateTime                @default(now())
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([provider, statementDate])
  @@index([status, statementDate])
  @@map("reconciliation_runs")
}

model OwnerNotificationSettings {
  id String @id @db.VarChar(40)
  revision Int @default(1)
  payloadEncrypted String @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("owner_notification_settings")
}

model OwnerNotificationSeen {
  eventId BigInt @id @db.UnsignedBigInt
  event PaymentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@map("owner_notification_seen")
}

model OwnerNotificationDelivery {
  id String @id @default(cuid())
  dedupeKey String @unique @db.VarChar(160)
  channel String @db.VarChar(16)
  title String @db.VarChar(160)
  message String @db.Text
  status String @default("PENDING") @db.VarChar(16)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseOwner String? @db.VarChar(40)
  lockedUntil DateTime?
  lastError String? @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
  @@map("owner_notification_deliveries")
}

model BillChannelSettings {
  id               String   @id @db.VarChar(80)
  revision         Int      @default(1)
  payloadEncrypted String   @db.LongText
  updatedAt        DateTime @updatedAt

  @@map("bill_channel_settings")
}

model BillCollectorState {
  id                String   @id @db.VarChar(80)
  binding           String   @db.Char(64)
  cursorAt          DateTime
  windowStart       DateTime?
  windowEnd         DateTime?
  nextPage          Int      @default(1)
  leaseOwner        String?  @db.VarChar(64)
  lockedUntil       DateTime?
  nextRunAt         DateTime @default(now())
  heartbeatAt       DateTime?
  lastSuccessAt     DateTime?
  lastError         String?  @db.VarChar(500)
  consecutiveErrors Int      @default(0)
  processedRecords  Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@map("bill_collector_states")
}

model ReceiptAccount {
  id        String   @id @db.VarChar(80)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reservations ReceiptMatchReservation[]

  @@map("receipt_accounts")
}

model ReceiptMatchReservation {
  id         String           @id @default(cuid())
  accountId  String           @db.VarChar(80)
  mode       ReceiptMatchMode
  value      String           @db.VarChar(64)
  paymentId  String           @unique
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  account    ReceiptAccount   @relation(fields: [accountId], references: [id])
  payment    Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([accountId, mode, value])
  @@index([accountId, expiresAt])
  @@map("receipt_match_reservations")
}

model PaymentException {
  id            String                   @id @default(cuid())
  exceptionNo   String                   @unique @db.VarChar(40)
  type          PaymentExceptionType
  status        PaymentExceptionStatus   @default(OPEN)
  severity      PaymentExceptionSeverity
  subjectType   String                   @db.VarChar(24)
  subjectId     String                   @db.VarChar(191)
  orderId       String?
  paymentId     String?
  source        String                   @db.VarChar(32)
  summary       String                   @db.VarChar(300)
  detail        Json?
  resolution    String?                  @db.VarChar(500)
  resolutionRef String?                  @db.VarChar(80)
  detectedAt    DateTime                 @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  order         Order?                   @relation(fields: [orderId], references: [id])
  payment       Payment?                 @relation(fields: [paymentId], references: [id])

  @@unique([subjectType, subjectId, type])
  @@index([status, severity, detectedAt])
  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("payment_exceptions")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actor        String   @default("admin-token") @db.VarChar(80)
  action       String   @db.VarChar(80)
  resourceType String?  @db.VarChar(40)
  resourceId   String?  @db.VarChar(191)
  method       String   @db.VarChar(12)
  path         String   @db.VarChar(255)
  requestId    String?  @db.VarChar(64)
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(500)
  success      Boolean
  statusCode   Int      @db.UnsignedSmallInt
  errorCode    String?  @db.VarChar(80)
  createdAt    DateTime @default(now())

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("admin_audit_logs")
}
