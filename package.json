{
  "name": "tuoxin-pay",
  "version": "1.0.3",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @tuoxin-pay/api",
    "dev:web": "npm run dev --workspace @tuoxin-pay/web",
    "dev:worker": "npm run dev:worker --workspace @tuoxin-pay/api",
    "build": "npm run db:generate && npm run build --workspace @tuoxin-pay/api && npm run build --workspace @tuoxin-pay/web",
    "typecheck": "npm run typecheck --workspace @tuoxin-pay/api && npm run typecheck --workspace @tuoxin-pay/web",
    "test": "npm run test --workspace @tuoxin-pay/api && npm run test --workspace @tuoxin-pay/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "app:create": "npm run app:create --workspace @tuoxin-pay/api --",
    "release:prepare": "node scripts/release-version.mjs --set",
    "release:check": "node scripts/release-version.mjs --check",
    "release:test": "node --test scripts/release-version.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "^1.56.1",
    "prisma": "6.12.0",
    "typescript-eslint": "8.71.1"
  },
  "dependencies": {
    "@prisma/client": "6.12.0"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true,
    "esbuild@0.28.2": true
  }
}
