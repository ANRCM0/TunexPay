NODE_ENV=development

# Single public entrypoint. In production set both to the same HTTPS domain.
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000

# 内部端口（一般无需修改）。使用 docker compose 时这些值由 compose 固定，改这里不会生效；
# 仅在不使用 compose、直接运行构建产物时才需要设置：
#   node apps/api/dist/server.js / node apps/api/dist/worker.js / node docker/gateway.mjs
# PORT=3001                 # Hono API 监听端口（apps/api/src/config.ts，默认 3001）
# API_INTERNAL_PORT=3001    # 容器入口启动 API 子进程时使用（docker/entrypoint.sh）
# WEB_INTERNAL_PORT=3000    # 容器入口启动 Next.js 子进程时使用（docker/entrypoint.sh）
# GATEWAY_PORT=8080         # 单入口网关端口，Dockerfile EXPOSE 8080（docker/gateway.mjs）
# INTERNAL_API_URL=         # Web BFF 访问 API 的内部地址，默认 http://127.0.0.1:${API_INTERNAL_PORT}（docker/entrypoint.sh）

# Docker image and container names used by Compose.
TUNEXPAY_IMAGE=ghcr.io/paimoncai/tunexpay
TUNEXPAY_IMAGE_TAG=latest
TUNEXPAY_CONTAINER_NAME=tunexpay
TUNEXPAY_MYSQL_CONTAINER_NAME=tunexpay-mysql
TUNEXPAY_REDIS_CONTAINER_NAME=tunexpay-redis

# Default Compose-managed database and Redis.
DATABASE_URL=mysql://tuoxin:change-me@mysql:3306/tuoxin_pay
REDIS_URL=redis://redis:6379
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

# To use MySQL installed on the Docker host instead, use for example:
# DATABASE_URL=mysql://tuoxin:your-password@host.docker.internal:3306/tuoxin_pay
# The host MySQL must listen on an address reachable from Docker; keep port 3306 blocked from the public Internet.

# 0 means keep waiting indefinitely for the database at container startup.
DB_MIGRATION_RETRY_SECONDS=5
DB_MIGRATION_MAX_ATTEMPTS=0

# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Used only by the web console. Keep these different from ADMIN_TOKEN.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Read-only MCP endpoint for AI agents. Keep disabled unless you use it.
# Generate MCP_TOKEN separately; never reuse ADMIN_TOKEN.
MCP_ENABLED=false
MCP_TOKEN=replace-with-a-separate-random-mcp-token

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 签名算法固定为 RSA2，不可配置：compose 中硬编码，apps/api/src/config.ts 也只接受 RSA2。
# ALIPAY_SIGN_TYPE=RSA2

# Personal QR-code receipt channel. Keep disabled until its watcher is deployed.
ALIPAY_BILL_ENABLED=false
# 以下账单参数仅首次导入数据库；后续请在支付渠道面板配置。
ALIPAY_BILL_COLLECTOR_ENABLED=false
# 与应用关联且有账务查询权限的收款账号（2088 开头）。
ALIPAY_BILL_USER_ID=
ALIPAY_BILL_POLL_SECONDS=10
ALIPAY_BILL_LOOKBACK_SECONDS=3600
ALIPAY_BILL_OVERLAP_SECONDS=300
ALIPAY_BILL_LAG_SECONDS=15
ALIPAY_BILL_QR_CONTENT=
ALIPAY_BILL_MATCH_MODE=AMOUNT
ALIPAY_BILL_VALID_SECONDS=300
ALIPAY_BILL_AMOUNT_OFFSET_MAX=99
ALIPAY_BILL_WATCHER_TOKEN=replace-with-a-long-random-watcher-token

# Explicitly enable these only for local development; never accept Mock orders as real payments.
MOCK_CHANNEL_ENABLED=false
MOCK_CHANNEL_TOKEN=local-development-only
ALLOW_PRIVATE_WEBHOOKS=false
LOG_LEVEL=info
